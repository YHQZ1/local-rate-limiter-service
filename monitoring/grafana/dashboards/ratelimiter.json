    {
      "id": 11,
      "type": "timeseries",
      "title": "Active keys per pod",
      "description": "Each pod keeps its own buckets, so a key's traffic is split across pods.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 12,
        "w": 8,
        "h": 8
