          "expr": "histogram_quantile(0.95, sum by (le) (rate(ratelimiter_http_request_duration_seconds_bucket{path=\"/check\"}[1m])))",
          "legendFormat": "p95",
          "editorMode": "code",
          "range": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(ratelimiter_http_request_duration_seconds_bucket{path=\"/check\"}[1m])))",
          "legendFormat": "p99",
